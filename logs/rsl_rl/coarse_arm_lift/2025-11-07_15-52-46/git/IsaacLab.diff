+            else:
+                point_set = point_set[0:self.npoints, :]
+                
+        point_set[:, 0:3] = pc_normalize(point_set[:, 0:3])
+        if not self.use_normals:
+            point_set = point_set[:, 0:3]
+
+        return point_set, label[0]
+
+    def __getitem__(self, index):
